# Required. This must identify a dedicated Ministry database whose role has no
# privileges on the parish application database. There is intentionally no
# fallback to COCKROACHDB_CONNECTION_STRING.
MINISTRY_DATABASE_URL=

# Fail closed. Enable only after reviewing the recipient preview/count in the
# isolated database.
MINISTRY_OUTBOUND_DELIVERY_ENABLED=false
MINISTRY_MAX_NOTIFICATION_RECIPIENTS=25

# Shared Priory priest-allocation Google Sheet (optional).
# Prefer the JSON credential in production. The split values are supported for
# hosts that cannot safely preserve a JSON environment value.
GOOGLE_PRIORY_SCHEDULE_CREDENTIALS_JSON=
GOOGLE_PRIORY_SCHEDULE_CLIENT_EMAIL=
GOOGLE_PRIORY_SCHEDULE_PRIVATE_KEY=

# Comma-separated operational recipients for new allocation requests.
PRIORY_SCHEDULE_NOTIFICATION_EMAILS=
PRIORY_SCHEDULE_TELEGRAM_CHAT_IDS=
