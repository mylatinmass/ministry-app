{
  "name": "@mylatinmass/ministry-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local ./node_modules/astro/bin/astro.mjs dev",
    "prebuild": "node --env-file-if-exists=.env.local scripts/sync-mass-schedule.mjs --build",
    "build": "astro build",
    "check": "astro check",
    "snapshot": "node scripts/snapshot-data.mjs",
    "migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "verify:database-isolation": "node --env-file-if-exists=.env.local scripts/verify-database-isolation.mjs",
    "sync:mass-schedule": "node --env-file-if-exists=.env.local scripts/sync-mass-schedule.mjs --required",
    "check:mass-schedule-sync": "node --env-file-if-exists=.env.local scripts/check-mass-schedule-sync.mjs",
    "test:mass-schedule": "node scripts/test-mass-schedule.mjs",
    "verify": "node scripts/verify.mjs",
    "smoke:new-features": "node --env-file-if-exists=.env.local scripts/smoke-new-features.mjs"
  },
  "dependencies": {
    "@astrojs/react": "6.0.1",
    "@astrojs/vercel": "11.0.3",
    "@heroicons/react": "2.1.5",
    "astro": "7.1.3",
    "bcryptjs": "2.4.3",
    "google-auth-library": "10.9.0",
    "jsonwebtoken": "9.0.2",
    "jspdf": "^3.0.4",
    "nodemailer": "9.0.3",
    "pg": "8.16.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-helmet": "6.1.0",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.4",
    "@types/node": "24.10.1",
    "@types/nodemailer": "7.0.4",
    "@types/pg": "8.16.0",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@types/web-push": "3.6.4",
    "autoprefixer": "10.4.23",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3"
  },
  "overrides": {
    "path-to-regexp": "6.3.0"
  }
}
