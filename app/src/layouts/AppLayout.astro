---
import "../styles/global.css"

const { title = "Ministries | MyLatinMass.com", referrer = "strict-origin-when-cross-origin" } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="referrer" content={referrer} />
    <meta name="theme-color" content="#896542" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/icons/icon-192.png" />
    <title>{title}</title>
    <script is:inline>
      try {
        const theme = localStorage.getItem("ministry_active_theme") === "dark" ? "dark" : "light"
        document.documentElement.dataset.ministryTheme = theme
        document.documentElement.style.colorScheme = theme
        document.querySelector('meta[name="theme-color"]')?.setAttribute("content", theme === "dark" ? "#111827" : "#896542")
      } catch (_) {}
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
