---
import "../styles/global.css"

const { title = "Ministries | MyLatinMass.com", referrer = "strict-origin-when-cross-origin" } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="referrer" content={referrer} />
    <meta name="theme-color" content="#896542" />
    <link rel="manifest" href="/ministry/manifest.webmanifest" />
    <link rel="icon" href="/ministry/icons/icon-192.png" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
